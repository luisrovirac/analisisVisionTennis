# Copia este archivo a `.env` (no se versiona) y ajusta los valores.
# Todos los servicios de deploy/docker-compose.yml lo leen.

# --- PostgreSQL ---
POSTGRES_USER=tennis
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=tennis
DATABASE_URL=postgres://tennis:change_me_dev_only@postgres:5432/tennis?sslmode=disable

# --- Redis (cola de trabajos) ---
REDIS_URL=redis://redis:6379/0
JOB_STREAM=analysis_jobs
JOB_GROUP=analysis_workers

# --- Almacenamiento de objetos (MinIO en local, Cloudflare R2 en producción) ---
MINIO_ROOT_USER=minio_root
MINIO_ROOT_PASSWORD=change_me_dev_only
# Credenciales de la aplicación (minio-init crea este usuario con permisos solo de lectura/escritura)
S3_ACCESS_KEY=tennis_app
S3_SECRET_KEY=change_me_dev_only_app
S3_BUCKET=tennis-videos
S3_REGION=us-east-1
# Endpoint interno (red de docker) usado por la API y el worker
S3_ENDPOINT=minio:9000
S3_USE_SSL=false
# Endpoint con el que se firman las URLs de subida: debe ser alcanzable desde el navegador/móvil.
# Para probar desde un teléfono en la misma red, usa la IP LAN del PC (ej. 192.168.1.20:9000).
S3_PUBLIC_ENDPOINT=localhost:9000
S3_PUBLIC_USE_SSL=false

# --- API (Go) ---
API_PORT=8080
UPLOAD_URL_TTL=15m
MAX_UPLOAD_MB=200
LOG_LEVEL=info
# Emails (verificados en el IdP) que reciben el rol admin al iniciar sesión. Crea el primer admin;
# después los roles se gestionan desde el portal (Administración). Con AUTH_DISABLED usa dev@localhost.
BOOTSTRAP_ADMIN_EMAILS=

# --- Worker (Python) ---
POSE_MODEL_PATH=/models/pose_landmarker_full.task
KNOWLEDGE_BASE_DIR=/app/knowledge_base
MAX_VIDEO_SECONDS=30
MAX_ATTEMPTS=3
JOB_CLAIM_IDLE_SECONDS=600
MIN_POSE_DETECTION_RATE=0.6
# Lo usan el worker (motor de reglas) y la API (previsualización de impacto en el portal).
MIN_METRIC_CONFIDENCE=0.5
# postgres: base de conocimiento publicada desde el portal de expertos (el YAML solo siembra la
# primera versión); yaml: solo los archivos de KNOWLEDGE_BASE_DIR (desarrollo sin portal).
KNOWLEDGE_SOURCE=postgres
KNOWLEDGE_REFRESH_SECONDS=15

# --- Autenticación (OIDC) ---
# APP_ENV=dev permite AUTH_DISABLED=true (usuario fijo, sin login). Nunca en producción.
APP_ENV=dev
AUTH_DISABLED=false
# `iss` exacto de los tokens: la URL pública de Keycloak (la que ve el navegador o el móvil).
OIDC_ISSUER_URL=http://localhost:8180/realms/tennis
OIDC_AUDIENCE=tennis-api
# Las claves se descargan por la red interna de docker (localhost:8180 no es alcanzable desde la API).
OIDC_JWKS_URL=http://keycloak:8080/realms/tennis/protocol/openid-connect/certs
OIDC_WEB_CLIENT_ID=tennis-web

# --- Keycloak (solo desarrollo) ---
# URL pública: debe coincidir con OIDC_ISSUER_URL. Para probar desde un teléfono usa la IP LAN
# en las dos (ej. http://192.168.1.20:8180) y añádela a las redirect URIs del cliente.
KC_HOSTNAME=http://localhost:8180
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me_dev_only

# --- Observabilidad (OpenTelemetry) ---
# Vacío = telemetría desactivada. Grafana: http://localhost:3001 (admin/admin la primera vez).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
# Cada servicio pone su propio OTEL_SERVICE_NAME por defecto (tennis-api / tennis-worker).
# Cola: dead letter queue de los trabajos que agotan MAX_ATTEMPTS (por defecto "<JOB_STREAM>:dlq").
JOB_DLQ_STREAM=analysis_jobs:dlq

# --- MLOps (perfil "ml" del compose) ---
ML_S3_BUCKET=tennis-ml
ML_S3_ACCESS_KEY=tennis_ml
ML_S3_SECRET_KEY=change_me_dev_only_ml
# El runner de ML y el servidor de MLflow usan estas credenciales (las mismas del usuario de ML).
AWS_ACCESS_KEY_ID=tennis_ml
AWS_SECRET_ACCESS_KEY=change_me_dev_only_ml

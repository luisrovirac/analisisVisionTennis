{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tennis-vision/report/1.0",
  "title": "Report",
  "description": "Resultado de un análisis. El worker lo escribe en analyses.report y la API lo devuelve tal cual. Revisión 1.1 (aditiva): strengths, diagnosis, drill_plan, reliability, knowledge_status y findings[].validated son opcionales; schema_version sigue en 1.0 y los clientes deben ignorar campos desconocidos.",
  "type": "object",
  "required": [
    "schema_version",
    "stroke_type",
    "segment",
    "metrics",
    "findings",
    "quality",
    "knowledge_base_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stroke_type": {
      "enum": [
        "forehand",
        "backhand",
        "serve",
        "volley"
      ]
    },
    "segment": {
      "type": "object",
      "required": [
        "fps",
        "start_frame",
        "backswing_frame",
        "impact_frame",
        "end_frame"
      ],
      "properties": {
        "fps": {
          "type": "number"
        },
        "start_frame": {
          "type": "integer"
        },
        "backswing_frame": {
          "type": "integer"
        },
        "impact_frame": {
          "type": "integer"
        },
        "end_frame": {
          "type": "integer"
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "value",
          "unit",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Errores detectados, ordenados de más simple/fundamental a más complejo (rank 1 = corregir primero).",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "rank",
          "category",
          "title",
          "explanation",
          "correction",
          "drills",
          "evidence"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "enum": [
              "fundamental",
              "sincronizacion"
            ]
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "correction": {
            "type": "string"
          },
          "drills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "validated": {
            "type": "boolean",
            "description": "1.1: la regla fue aprobada por un validador (false = provisional)."
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "pose_detection_rate",
        "warnings"
      ],
      "properties": {
        "pose_detection_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "knowledge_base_version": {
      "type": "string",
      "description": "ej. forehand@0.1.0"
    },
    "classification": {
      "description": "Opcional. Cómo se decidió el golpe: el usuario o un modelo, y con qué modelo y datos.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "stroke",
        "confidence",
        "classifier_id"
      ],
      "properties": {
        "stroke": {
          "enum": [
            "forehand",
            "backhand",
            "serve",
            "volley"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classifier_id": {
          "type": "string",
          "description": "user, pose_seq, yolo o vote"
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_hash": {
          "type": [
            "string",
            "null"
          ],
          "description": "Hash DVC de los datos de entrenamiento"
        }
      }
    },
    "strengths": {
      "type": "array",
      "description": "1.1: puntos fuertes detectados (máx. 5), del más relevante al menos.",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "rank",
          "category",
          "title",
          "why_it_matters",
          "how_to_maintain",
          "evidence",
          "confidence"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "enum": [
              "fundamental",
              "sincronizacion"
            ]
          },
          "title": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "how_to_maintain": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "validated": {
            "type": "boolean"
          }
        }
      }
    },
    "diagnosis": {
      "description": "1.1: conclusión principal: causa raíz, síntomas que explica y límites de la medición.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "summary",
        "root_cause_rule_id",
        "contributing_factors",
        "strengths_to_leverage",
        "limitations",
        "unmeasurable"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "root_cause_rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "contributing_factors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strengths_to_leverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unmeasurable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "drill_plan": {
      "description": "1.1: plan de ejercicios por semanas, un foco a la vez.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "weeks",
        "items",
        "reanalyze_after_weeks"
      ],
      "properties": {
        "weeks": {
          "type": "integer",
          "minimum": 1
        },
        "reanalyze_after_weeks": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "week",
              "focus_rule_id",
              "focus",
              "drills"
            ],
            "properties": {
              "week": {
                "type": "integer",
                "minimum": 1
              },
              "focus_rule_id": {
                "type": "string"
              },
              "focus": {
                "type": "string"
              },
              "drills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "reliability": {
      "description": "1.1: cuánto confiar en este informe (calidad de pose y confianza de las métricas).",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "score",
        "level",
        "reasons"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "knowledge_status": {
      "description": "1.1: cuántas reglas de la base de conocimiento usada están validadas. Sin nombres.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "status",
        "validated_rules",
        "total_rules"
      ],
      "properties": {
        "status": {
          "enum": [
            "provisional",
            "partially_validated",
            "validated"
          ]
        },
        "validated_rules": {
          "type": "integer",
          "minimum": 0
        },
        "total_rules": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
